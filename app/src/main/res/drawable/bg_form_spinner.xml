<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined dropdown matching the outlined text fields -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dashboard_card" />
            <stroke
                android:width="1dp"
                android:color="@color/form_outline" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item
        android:width="24dp"
        android:height="24dp"
        android:end="12dp"
        android:drawable="@drawable/ic_form_arrow_drop_down"
        android:gravity="end|center_vertical" />
</layer-list>
