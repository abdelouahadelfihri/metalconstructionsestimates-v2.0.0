<?xml version="1.0" encoding="utf-8"?>
<!-- Add customer: identity, contact and address cards with a fixed Clear / Add bar -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#0066cc"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
        app:title="@string/addCustomer"
        app:logo="@drawable/ic_toolbar_customers"
        app:contentInsetStartWithNavigation="0dp"
        app:titleMarginStart="10dp"
        app:titleTextAppearance="@style/ListToolbarTitle"
        app:titleTextColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <!-- Full width on phones, capped and centered on tablets -->
            <LinearLayout
                android:id="@+id/formContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/form_max_width">

                <LinearLayout
                    style="@style/FormHero">

                    <ImageView
                        style="@style/FormHeroIcon"
                        android:src="@drawable/ic_toolbar_customers" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FormHeroTitle"
                            android:text="@string/form_new_customer_title" />

                        <TextView
                            style="@style/FormHeroSubtitle"
                            android:text="@string/form_new_customer_subtitle" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/FormCard">

                    <LinearLayout
                        style="@style/DashboardCardContent">

                        <LinearLayout
                            style="@style/FormSectionHeader">

                            <ImageView
                                style="@style/FormSectionIcon"
                                android:src="@drawable/ic_form_person" />

                            <LinearLayout
                                style="@style/FormSectionText">

                                <TextView
                                    style="@style/DashboardCardTitle"
                                    android:text="@string/form_section_identity" />

                                <TextView
                                    style="@style/DashboardCardSubtitle"
                                    android:text="@string/form_section_identity_subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/nameLayout"
                            style="@style/FormField"
                            android:hint="@string/customer_name"
                            app:startIconDrawable="@drawable/ic_form_person">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etName_add_customer"
                                style="@style/FormFieldInput"
                                android:inputType="textPersonName|textCapWords" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/FormCard">

                    <LinearLayout
                        style="@style/DashboardCardContent">

                        <LinearLayout
                            style="@style/FormSectionHeader">

                            <ImageView
                                style="@style/FormSectionIcon"
                                android:src="@drawable/ic_form_phone" />

                            <LinearLayout
                                style="@style/FormSectionText">

                                <TextView
                                    style="@style/DashboardCardTitle"
                                    android:text="@string/form_section_contact" />

                                <TextView
                                    style="@style/DashboardCardSubtitle"
                                    android:text="@string/form_section_contact_subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/emailLayout"
                            style="@style/FormField"
                            android:hint="@string/customer_email"
                            app:startIconDrawable="@drawable/ic_form_email">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etEmail_add_customer"
                                style="@style/FormFieldInput"
                                android:inputType="textEmailAddress" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            style="@style/FormRow">
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/phoneLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="12dp"
                                android:hint="@string/customer_phone"
                                app:startIconDrawable="@drawable/ic_form_phone">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etPhone_add_customer"
                                    style="@style/FormFieldInput"
                                    android:inputType="phone" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/mobileLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="@string/customer_mobile"
                                app:startIconDrawable="@drawable/ic_form_mobile">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/etMobile_add_customer"
                                    style="@style/FormFieldInput"
                                    android:inputType="phone" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/faxLayout"
                            style="@style/FormField"
                            android:hint="@string/customer_fax"
                            app:startIconDrawable="@drawable/ic_form_fax">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etFax_add_customer"
                                style="@style/FormFieldInput"
                                android:inputType="phone" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/FormCard">

                    <LinearLayout
                        style="@style/DashboardCardContent">

                        <LinearLayout
                            style="@style/FormSectionHeader">

                            <ImageView
                                style="@style/FormSectionIcon"
                                android:src="@drawable/ic_form_place" />

                            <LinearLayout
                                style="@style/FormSectionText">

                                <TextView
                                    style="@style/DashboardCardTitle"
                                    android:text="@string/form_section_address" />

                                <TextView
                                    style="@style/DashboardCardSubtitle"
                                    android:text="@string/form_section_address_subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/addressLayout"
                            style="@style/FormField"
                            android:hint="@string/customer_address">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etAddress_add_customer"
                                style="@style/FormFieldInput"
                                android:gravity="top"
                                android:inputType="textPostalAddress|textMultiLine|textCapSentences"
                                android:minLines="3" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Actions stay visible at the bottom -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonContainer"
        style="@style/FormActionBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/form_max_width">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClear_add_customer"
                style="@style/FormSecondaryButton"
                android:layout_marginEnd="6dp"
                android:text="@string/clear" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdd_add_customer"
                style="@style/FormPrimaryButton"
                android:layout_marginStart="6dp"
                android:text="@string/add" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
