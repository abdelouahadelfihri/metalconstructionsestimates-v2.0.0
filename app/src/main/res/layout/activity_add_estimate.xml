<?xml version="1.0" encoding="utf-8"?>
<!-- Add estimate: general, dates, customer and pricing cards with a fixed Clear / Add bar -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#0066cc"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
        app:title="@string/addEstimate"
        app:logo="@drawable/ic_toolbar_estimates"
        app:contentInsetStartWithNavigation="0dp"
        app:titleMarginStart="10dp"
        app:titleTextAppearance="@style/ListToolbarTitle"
        app:titleTextColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <!-- Full width on phones, capped and centered on tablets -->
            <LinearLayout
                android:id="@+id/formContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/form_max_width">

                <LinearLayout
                    style="@style/FormHero">

                    <ImageView
                        style="@style/FormHeroIcon"
                        android:src="@drawable/ic_toolbar_estimates" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FormHeroTitle"
                            android:text="@string/form_new_estimate_title" />

                        <TextView
                            style="@style/FormHeroSubtitle"
                            android:text="@string/form_new_estimate_subtitle" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/FormCard">

                    <LinearLayout
                        style="@style/DashboardCardContent">

                        <LinearLayout
                            style="@style/FormSectionHeader">

                            <ImageView
                                style="@style/FormSectionIcon"
                                android:src="@drawable/ic_toolbar_estimates" />

                            <LinearLayout
                                style="@style/FormSectionText">

                                <TextView
                                    style="@style/DashboardCardTitle"
                                    android:text="@string/form_section_general" />

                                <TextView
                                    style="@style/DashboardCardSubtitle"
                                    android:text="@string/form_section_general_subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/locationLayout"
                            style="@style/FormField"
                            android:hint="@string/location"
                            app:startIconDrawable="@drawable/ic_form_place">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/locationEditText_add_estimate"
                                style="@style/FormFieldInput"
                                android:inputType="textCapSentences" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/estimate_status_label"
                            style="@style/FormSpinnerLabel"
                            android:text="@string/status" />

                        <Spinner
                            android:id="@+id/estimateStatusSpinner"
                            style="@style/FormSpinner" />

                        <TextView
                            android:id="@+id/dueTermsLabel"
                            style="@style/FormSpinnerLabel"
                            android:text="@string/dueTerms" />

                        <Spinner
                            android:id="@+id/dueTermsSpinner"
                            style="@style/FormSpinner" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/FormCard">

                    <LinearLayout
                        style="@style/DashboardCardContent">

                        <LinearLayout
                            style="@style/FormSectionHeader">

                            <ImageView
                                style="@style/FormSectionIcon"
                                android:src="@drawable/ic_calendar" />

                            <LinearLayout
                                style="@style/FormSectionText">

                                <TextView
                                    style="@style/DashboardCardTitle"
                                    android:text="@string/form_section_dates" />

                                <TextView
                                    style="@style/DashboardCardSubtitle"
                                    android:text="@string/form_section_dates_subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            style="@style/DetailsRow">
                            <TextView
                                android:id="@+id/issueDateLabel"
                                style="@style/DetailsLabel"
                                android:text="@string/issueDateLabel" />

                            <TextView
                                android:id="@+id/issueDateValue"
                                style="@style/DetailsDateValue"
                                android:text="@string/issueDate" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/DetailsRow">
                            <TextView
                                android:id="@+id/dueDateLabel"
                                style="@style/DetailsLabel"
                                android:text="@string/dueDateLabel" />

                            <TextView
                                android:id="@+id/dueDateValue"
                                style="@style/DetailsDateValue"
                                android:text="@string/dueDate" />
                        </LinearLayout>

                        <LinearLayout
                            style="@style/DetailsRow">
                            <TextView
                                android:id="@+id/expirationDateLabel"
                                style="@style/DetailsLabel"
                                android:text="@string/expirationDateLabel" />

                            <TextView
                                android:id="@+id/expirationDateValue"
                                style="@style/DetailsDateValue"
                                android:text="@string/expirationDate" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/FormCard">

                    <LinearLayout
                        style="@style/DashboardCardContent">

                        <LinearLayout
                            style="@style/FormSectionHeader">

                            <ImageView
                                style="@style/FormSectionIcon"
                                android:src="@drawable/ic_toolbar_customers" />

                            <LinearLayout
                                style="@style/FormSectionText">

                                <TextView
                                    style="@style/DashboardCardTitle"
                                    android:text="@string/form_section_customer" />

                                <TextView
                                    style="@style/DashboardCardSubtitle"
                                    android:text="@string/form_section_customer_subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            style="@style/FormRow">
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/customerLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="@string/customer"
                                app:startIconDrawable="@drawable/ic_form_person">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/customerEditText_add_estimate"
                                    style="@style/FormFieldInput"
                                    android:inputType="textPersonName" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/selectCustomerButton_add_estimate"
                                style="@style/FormTonalButton"
                                android:text="@string/selectCustomer" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/FormCard">

                    <LinearLayout
                        style="@style/DashboardCardContent">

                        <LinearLayout
                            style="@style/FormSectionHeader">

                            <ImageView
                                style="@style/FormSectionIcon"
                                android:src="@drawable/ic_form_money" />

                            <LinearLayout
                                style="@style/FormSectionText">

                                <TextView
                                    style="@style/DashboardCardTitle"
                                    android:text="@string/form_section_pricing" />

                                <TextView
                                    style="@style/DashboardCardSubtitle"
                                    android:text="@string/form_section_pricing_estimate_subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            style="@style/FormRow">
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/discountLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="12dp"
                                android:hint="@string/discount">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/discountEditText_add_estimate"
                                    style="@style/FormFieldInput"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/vatLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="@string/vat">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/vatEditText_add_estimate"
                                    style="@style/FormFieldInput"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Actions stay visible at the bottom -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonContainer"
        style="@style/FormActionBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/form_max_width">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearButton_add_estimate"
                style="@style/FormSecondaryButton"
                android:layout_marginEnd="6dp"
                android:text="@string/clear" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addButton_add_estimate"
                style="@style/FormPrimaryButton"
                android:layout_marginStart="6dp"
                android:text="@string/add" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
