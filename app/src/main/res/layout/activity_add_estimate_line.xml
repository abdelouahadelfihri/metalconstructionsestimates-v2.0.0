<?xml version="1.0" encoding="utf-8"?>
<!-- Add estimate line: steel, dimensions and pricing cards with a fixed Clear / Add bar -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#0066cc"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
        app:title="@string/addEstimateLine"
        app:logo="@drawable/ic_toolbar_estimate_lines"
        app:contentInsetStartWithNavigation="0dp"
        app:titleMarginStart="10dp"
        app:titleTextAppearance="@style/ListToolbarTitle"
        app:titleTextColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <!-- Full width on phones, capped and centered on tablets -->
            <LinearLayout
                android:id="@+id/formContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/form_max_width">

                <LinearLayout
                    style="@style/FormHero">

                    <ImageView
                        style="@style/FormHeroIcon"
                        android:src="@drawable/ic_toolbar_estimate_lines" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FormHeroTitle"
                            android:text="@string/form_new_line_title" />

                        <TextView
                            style="@style/FormHeroSubtitle"
                            android:text="@string/form_new_line_subtitle" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/FormCard">

                    <LinearLayout
                        style="@style/DashboardCardContent">

                        <LinearLayout
                            style="@style/FormSectionHeader">

                            <ImageView
                                style="@style/FormSectionIcon"
                                android:src="@drawable/ic_toolbar_steels" />

                            <LinearLayout
                                style="@style/FormSectionText">

                                <TextView
                                    style="@style/DashboardCardTitle"
                                    android:text="@string/form_section_steel" />

                                <TextView
                                    style="@style/DashboardCardSubtitle"
                                    android:text="@string/form_section_steel_subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            style="@style/FormRow">
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/steelTypeLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="@string/steelType"
                                app:startIconDrawable="@drawable/ic_form_tag">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/steelTypeEditText_add_estimate_line"
                                    style="@style/FormFieldInput"
                                    android:inputType="text"
                                    android:enabled="false" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/selectSteelButton"
                                style="@style/FormTonalButton"
                                android:text="@string/selectSteel" />
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/weightLayout"
                            style="@style/FormField"
                            android:hint="@string/weight">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/weightEditText_add_estimate_line"
                                style="@style/FormFieldInput"
                                android:inputType="numberDecimal"
                                android:enabled="false" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/FormCard">

                    <LinearLayout
                        style="@style/DashboardCardContent">

                        <LinearLayout
                            style="@style/FormSectionHeader">

                            <ImageView
                                style="@style/FormSectionIcon"
                                android:src="@drawable/ic_form_ruler" />

                            <LinearLayout
                                style="@style/FormSectionText">

                                <TextView
                                    style="@style/DashboardCardTitle"
                                    android:text="@string/form_section_dimensions" />

                                <TextView
                                    style="@style/DashboardCardSubtitle"
                                    android:text="@string/form_section_dimensions_subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/quantityLayout"
                            style="@style/FormField"
                            android:hint="@string/quantity">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/quantityEditText_add_estimate_line"
                                style="@style/FormFieldInput"
                                android:inputType="number" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <LinearLayout
                            style="@style/FormRow">
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/lengthLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="12dp"
                                android:hint="@string/length">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/lengthEditText_add_estimate_line"
                                    style="@style/FormFieldInput"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/widthLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="12dp"
                                android:hint="@string/width">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/widthEditText_add_estimate_line"
                                    style="@style/FormFieldInput"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/heightLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="@string/height">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/heightEditText_add_estimate_line"
                                    style="@style/FormFieldInput"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/totalLayout"
                            style="@style/FormField"
                            android:hint="@string/total">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/totalEditText_add_estimate_line"
                                style="@style/FormFieldInput"
                                android:inputType="numberDecimal"
                                android:enabled="false" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/FormCard">

                    <LinearLayout
                        style="@style/DashboardCardContent">

                        <LinearLayout
                            style="@style/FormSectionHeader">

                            <ImageView
                                style="@style/FormSectionIcon"
                                android:src="@drawable/ic_form_money" />

                            <LinearLayout
                                style="@style/FormSectionText">

                                <TextView
                                    style="@style/DashboardCardTitle"
                                    android:text="@string/form_section_pricing" />

                                <TextView
                                    style="@style/DashboardCardSubtitle"
                                    android:text="@string/form_section_pricing_line_subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            style="@style/FormRow">
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/marginLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="12dp"
                                android:hint="@string/margin">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/marginEditText_add_estimate_line"
                                    style="@style/FormFieldInput"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/netQuantityLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="@string/netQuantityPlusMargin">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/netQuantityEditText_add_estimate_line"
                                    style="@style/FormFieldInput"
                                    android:inputType="numberDecimal"
                                    android:enabled="false" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <LinearLayout
                            style="@style/FormRow">
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/unitPriceLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="12dp"
                                android:hint="@string/unitPrice">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/unitPriceEditText_add_estimate_line"
                                    style="@style/FormFieldInput"
                                    android:inputType="numberDecimal" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/totalPriceLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:hint="@string/totalPrice">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/totalPriceEditText_add_estimate_line"
                                    style="@style/FormFieldInput"
                                    android:inputType="numberDecimal"
                                    android:enabled="false" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Actions stay visible at the bottom -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonContainer"
        style="@style/FormActionBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/form_max_width">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clearButton_add_estimate_line"
                style="@style/FormSecondaryButton"
                android:layout_marginEnd="6dp"
                android:text="@string/clear" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addButton_add_estimate_line"
                style="@style/FormPrimaryButton"
                android:layout_marginStart="6dp"
                android:text="@string/add" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
