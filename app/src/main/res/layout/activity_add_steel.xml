<?xml version="1.0" encoding="utf-8"?>
<!-- Add steel: profile and weight cards with a fixed Clear / Add bar -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#0066cc"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
        app:title="@string/addSteel"
        app:logo="@drawable/ic_toolbar_steels"
        app:contentInsetStartWithNavigation="0dp"
        app:titleMarginStart="10dp"
        app:titleTextAppearance="@style/ListToolbarTitle"
        app:titleTextColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <!-- Full width on phones, capped and centered on tablets -->
            <LinearLayout
                android:id="@+id/formContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/form_max_width">

                <LinearLayout
                    style="@style/FormHero">

                    <ImageView
                        style="@style/FormHeroIcon"
                        android:src="@drawable/ic_toolbar_steels" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FormHeroTitle"
                            android:text="@string/form_new_steel_title" />

                        <TextView
                            style="@style/FormHeroSubtitle"
                            android:text="@string/form_new_steel_subtitle" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/FormCard">

                    <LinearLayout
                        style="@style/DashboardCardContent">

                        <LinearLayout
                            style="@style/FormSectionHeader">

                            <ImageView
                                style="@style/FormSectionIcon"
                                android:src="@drawable/ic_toolbar_steels" />

                            <LinearLayout
                                style="@style/FormSectionText">

                                <TextView
                                    style="@style/DashboardCardTitle"
                                    android:text="@string/form_section_profile" />

                                <TextView
                                    style="@style/DashboardCardSubtitle"
                                    android:text="@string/form_section_profile_subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textInputLayoutSteelType"
                            style="@style/FormField"
                            android:hint="@string/steelType"
                            app:startIconDrawable="@drawable/ic_form_tag">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTextSteelType"
                                style="@style/FormFieldInput"
                                android:inputType="text" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/spinner_geometric_shape_label"
                            style="@style/FormSpinnerLabel"
                            android:text="@string/shapeLabel" />

                        <Spinner
                            android:id="@+id/spinner_geometric_shape"
                            style="@style/FormSpinner" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/FormCard">

                    <LinearLayout
                        style="@style/DashboardCardContent">

                        <LinearLayout
                            style="@style/FormSectionHeader">

                            <ImageView
                                style="@style/FormSectionIcon"
                                android:src="@drawable/ic_form_scale" />

                            <LinearLayout
                                style="@style/FormSectionText">

                                <TextView
                                    style="@style/DashboardCardTitle"
                                    android:text="@string/form_section_weight" />

                                <TextView
                                    style="@style/DashboardCardSubtitle"
                                    android:text="@string/form_section_weight_subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/textInputLayoutWeight"
                            style="@style/FormField"
                            android:hint="@string/weight">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/editTextWeight"
                                style="@style/FormFieldInput"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/unitSpinnerLabel"
                            style="@style/FormSpinnerLabel"
                            android:text="@string/unitLabel" />

                        <Spinner
                            android:id="@+id/spinner_steel_unit"
                            style="@style/FormSpinner" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Actions stay visible at the bottom -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonContainer"
        style="@style/FormActionBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/form_max_width">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonClear"
                style="@style/FormSecondaryButton"
                android:layout_marginEnd="6dp"
                android:text="@string/clear" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonAdd"
                style="@style/FormPrimaryButton"
                android:layout_marginStart="6dp"
                android:text="@string/add" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
