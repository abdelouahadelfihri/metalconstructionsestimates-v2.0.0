<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0066cc"
        app:title="@string/dashboard"
        app:titleTextColor="@android:color/white" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- ══ Hero: total value ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:background="@drawable/bg_dashboard_hero"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboardTotalLabel"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/value_total"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="34sp"
                    app:autoSizeMinTextSize="18sp"
                    app:autoSizeTextType="uniform"
                    tools:text="1,250,000.00 DH" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboardTotalCaption"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_hero_chip"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboardAverage"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/value_average"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="25,000.00 DH" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_hero_chip"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboardApprovalRate"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/value_approval_rate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="64%" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ══ KPI counts ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout style="@style/DashboardKpi">

                        <ImageView
                            style="@style/DashboardKpiIcon"
                            android:contentDescription="@string/dashboardCustomers"
                            android:src="@drawable/customers" />

                        <TextView
                            android:id="@+id/value_customers"
                            style="@style/DashboardKpiValue"
                            tools:text="24" />

                        <TextView
                            style="@style/DashboardKpiLabel"
                            android:text="@string/dashboardCustomers" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout style="@style/DashboardKpi">

                        <ImageView
                            style="@style/DashboardKpiIcon"
                            android:contentDescription="@string/dashboardSteels"
                            android:src="@drawable/steels" />

                        <TextView
                            android:id="@+id/value_steels"
                            style="@style/DashboardKpiValue"
                            tools:text="45" />

                        <TextView
                            style="@style/DashboardKpiLabel"
                            android:text="@string/dashboardSteels" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout style="@style/DashboardKpi">

                        <ImageView
                            style="@style/DashboardKpiIcon"
                            android:contentDescription="@string/dashboardEstimates"
                            android:src="@drawable/estimates" />

                        <TextView
                            android:id="@+id/value_estimates"
                            style="@style/DashboardKpiValue"
                            tools:text="7" />

                        <TextView
                            style="@style/DashboardKpiLabel"
                            android:text="@string/dashboardEstimates" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ══ Charts: 1 column on phones, 2 on wide screens ══ -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="@integer/dashboard_columns"
                android:orientation="horizontal">

                <!-- Monthly value (full width) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:layout_width="0dp"
                    android:layout_columnSpan="@integer/dashboard_columns"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill">

                    <LinearLayout style="@style/DashboardCardContent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                style="@style/DashboardCardTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/dashboardRevenueTitle" />

                            <TextView
                                android:id="@+id/value_month_delta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="▲ 12% vs last month" />
                        </LinearLayout>

                        <TextView
                            style="@style/DashboardCardSubtitle"
                            android:text="@string/dashboardRevenueSubtitle" />

                        <com.example.metalconstructionsestimates.modules.dashboard.charts.BarChartView
                            android:id="@+id/chart_monthly"
                            android:layout_width="match_parent"
                            android:layout_height="210dp"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Status breakdown -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill">

                    <LinearLayout style="@style/DashboardCardContent">

                        <TextView
                            style="@style/DashboardCardTitle"
                            android:text="@string/dashboardStatusTitle" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.example.metalconstructionsestimates.modules.dashboard.charts.DonutChartView
                                android:id="@+id/chart_status"
                                android:layout_width="136dp"
                                android:layout_height="136dp" />

                            <LinearLayout
                                android:id="@+id/legend_status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Top customers -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill">

                    <LinearLayout style="@style/DashboardCardContent">

                        <TextView
                            style="@style/DashboardCardTitle"
                            android:text="@string/dashboardTopCustomersTitle" />

                        <TextView
                            style="@style/DashboardCardSubtitle"
                            android:text="@string/dashboardTopCustomersSubtitle" />

                        <LinearLayout
                            android:id="@+id/list_top_customers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/empty_top_customers"
                            style="@style/DashboardCardSubtitle"
                            android:layout_marginTop="16dp"
                            android:text="@string/dashboardNoCustomerData"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Activity by period (full width) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:layout_width="0dp"
                    android:layout_columnSpan="@integer/dashboard_columns"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill">

                    <LinearLayout style="@style/DashboardCardContent">

                        <TextView
                            style="@style/DashboardCardTitle"
                            android:text="@string/dashboardPeriodTitle" />

                        <com.google.android.material.tabs.TabLayout
                            android:id="@+id/tabLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@android:color/transparent"
                            android:contentDescription="@string/estimates"
                            app:tabGravity="fill"
                            app:tabIndicatorColor="@color/dashboard_brand"
                            app:tabIndicatorFullWidth="false"
                            app:tabIndicatorHeight="3dp"
                            app:tabMode="fixed"
                            app:tabSelectedTextColor="@color/dashboard_brand"
                            app:tabPaddingEnd="4dp"
                            app:tabPaddingStart="4dp"
                            app:tabTextAppearance="@style/DashboardTabText"
                            app:tabTextColor="@color/dashboard_text_secondary" />

                        <FrameLayout
                            android:id="@+id/periodContainer"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
