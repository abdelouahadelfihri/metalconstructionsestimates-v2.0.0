<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="#0066cc"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
        app:title="@string/dashboard"
        app:logo="@drawable/ic_toolbar_dashboard"
        app:contentInsetStartWithNavigation="0dp"
        app:titleMarginStart="10dp"
        app:titleTextAppearance="@style/ListToolbarTitle"
        app:titleTextColor="@android:color/white" />

    <!-- ══ Period selector (stays visible while scrolling) ══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/dashboard_card"
        android:elevation="2dp"
        android:orientation="vertical"
        android:paddingBottom="2dp">

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:contentDescription="@string/dashboardPeriodTitle"
            app:tabGravity="fill"
            app:tabIndicatorColor="@color/dashboard_brand"
            app:tabIndicatorFullWidth="false"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabPaddingEnd="2dp"
            app:tabPaddingStart="2dp"
            app:tabSelectedTextColor="@color/dashboard_brand"
            app:tabTextAppearance="@style/DashboardTabText"
            app:tabTextColor="@color/dashboard_text_secondary" />

        <!-- Shows the selected range; tap to pick a day or a custom period -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/value_period_range"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:minHeight="40dp"
            android:textAllCaps="false"
            android:textColor="@color/dashboard_brand"
            android:textSize="13sp"
            app:icon="@drawable/ic_calendar"
            app:iconPadding="6dp"
            app:iconSize="18dp"
            app:iconTint="@color/dashboard_brand"
            tools:text="1 Oct – 31 Oct 2026" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <!-- ══ Hero: total value ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="6dp"
                android:background="@drawable/bg_dashboard_hero"
                android:elevation="4dp"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboardTotalLabel"
                    android:textColor="#CCFFFFFF"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/value_total"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="2dp"
                    android:gravity="center_vertical"
                    android:maxLines="1"
                    android:textColor="@android:color/white"
                    android:textStyle="bold"
                    app:autoSizeMaxTextSize="34sp"
                    app:autoSizeMinTextSize="18sp"
                    app:autoSizeTextType="uniform"
                    tools:text="1,250,000.00 DH" />

                <TextView
                    android:id="@+id/value_period_caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboardTotalCaption"
                    android:textColor="#B3FFFFFF"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_hero_chip"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboardAverage"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/value_average"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="25,000.00 DH" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_hero_chip"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/dashboardApprovalRate"
                            android:textColor="#CCFFFFFF"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/value_approval_rate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:maxLines="1"
                            android:textColor="@android:color/white"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            tools:text="64%" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ══ KPI counts ══ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout style="@style/DashboardKpi">

                        <ImageView
                            style="@style/DashboardKpiIcon"
                            android:contentDescription="@string/dashboardCustomers"
                            android:src="@drawable/customers" />

                        <TextView
                            android:id="@+id/value_customers"
                            style="@style/DashboardKpiValue"
                            tools:text="24" />

                        <TextView
                            style="@style/DashboardKpiLabel"
                            android:text="@string/dashboardCustomers" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout style="@style/DashboardKpi">

                        <ImageView
                            style="@style/DashboardKpiIcon"
                            android:contentDescription="@string/dashboardSteels"
                            android:src="@drawable/steels" />

                        <TextView
                            android:id="@+id/value_steels"
                            style="@style/DashboardKpiValue"
                            tools:text="45" />

                        <TextView
                            style="@style/DashboardKpiLabel"
                            android:text="@string/dashboardSteels" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1">

                    <LinearLayout style="@style/DashboardKpi">

                        <ImageView
                            style="@style/DashboardKpiIcon"
                            android:contentDescription="@string/dashboardEstimates"
                            android:src="@drawable/estimates" />

                        <TextView
                            android:id="@+id/value_estimates"
                            style="@style/DashboardKpiValue"
                            tools:text="7" />

                        <TextView
                            style="@style/DashboardKpiLabel"
                            android:text="@string/dashboardEstimates" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ══ Charts: 1 column on phones, 2 on wide screens ══ -->
            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="@integer/dashboard_columns"
                android:orientation="horizontal">

                <!-- Monthly value (full width) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:layout_width="0dp"
                    android:layout_columnSpan="@integer/dashboard_columns"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill">

                    <LinearLayout style="@style/DashboardCardContent">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/title_trend"
                                style="@style/DashboardCardTitle"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:text="@string/dashboardRevenueTitle" />

                            <TextView
                                android:id="@+id/value_delta"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:textSize="12sp"
                                android:textStyle="bold"
                                tools:text="▲ 12% vs last month" />
                        </LinearLayout>

                        <TextView
                            style="@style/DashboardCardSubtitle"
                            android:text="@string/dashboardRevenueSubtitle" />

                        <com.example.metalconstructionsestimates.modules.dashboard.charts.BarChartView
                            android:id="@+id/chart_trend"
                            android:layout_width="match_parent"
                            android:layout_height="210dp"
                            android:layout_marginTop="12dp" />

                        <!-- Hourly view: estimates whose creation time is unknown -->
                        <TextView
                            android:id="@+id/note_trend"
                            style="@style/DashboardCardSubtitle"
                            android:layout_width="match_parent"
                            android:layout_marginTop="8dp"
                            android:visibility="gone"
                            tools:text="2 estimates (MAD 4,000.00) have no recorded time"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Status breakdown -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill">

                    <LinearLayout style="@style/DashboardCardContent">

                        <TextView
                            style="@style/DashboardCardTitle"
                            android:text="@string/dashboardStatusTitle" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <com.example.metalconstructionsestimates.modules.dashboard.charts.DonutChartView
                                android:id="@+id/chart_status"
                                android:layout_width="136dp"
                                android:layout_height="136dp" />

                            <LinearLayout
                                android:id="@+id/legend_status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="16dp"
                                android:layout_weight="1"
                                android:orientation="vertical" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Top customers -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:layout_width="0dp"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill">

                    <LinearLayout style="@style/DashboardCardContent">

                        <TextView
                            style="@style/DashboardCardTitle"
                            android:text="@string/dashboardTopCustomersTitle" />

                        <TextView
                            style="@style/DashboardCardSubtitle"
                            android:text="@string/dashboardTopCustomersSubtitle" />

                        <LinearLayout
                            android:id="@+id/list_top_customers"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/empty_top_customers"
                            style="@style/DashboardCardSubtitle"
                            android:layout_marginTop="16dp"
                            android:text="@string/dashboardNoCustomerData"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Estimates in the selected period (full width) -->
                <com.google.android.material.card.MaterialCardView
                    style="@style/DashboardCard"
                    android:layout_width="0dp"
                    android:layout_columnSpan="@integer/dashboard_columns"
                    android:layout_columnWeight="1"
                    android:layout_gravity="fill">

                    <LinearLayout style="@style/DashboardCardContent">

                        <TextView
                            style="@style/DashboardCardTitle"
                            android:text="@string/dashboardPeriodTitle" />

                        <TextView
                            android:id="@+id/tv_no_estimates"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:paddingTop="24dp"
                            android:paddingBottom="16dp"
                            android:text="@string/noEstimates"
                            android:textColor="@color/dashboard_text_secondary"
                            android:textSize="14sp"
                            android:visibility="gone" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_estimates"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:nestedScrollingEnabled="false" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
