<?xml version="1.0" encoding="utf-8"?>
<!-- Home: welcome card with live counts, then a grid of shortcuts (2, 3 or 4 per row by screen width) -->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/dashboard_bg">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#0066cc"
                android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
                app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
                app:title="@string/app_name"
                app:logo="@drawable/ic_toolbar_home"
                app:contentInsetStartWithNavigation="0dp"
                app:titleMarginStart="10dp"
                app:titleTextAppearance="@style/ListToolbarTitle"
                app:titleTextColor="@android:color/white" />

        </com.google.android.material.appbar.AppBarLayout>

        <androidx.core.widget.NestedScrollView
            android:id="@+id/nestedScroll"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:fillViewport="true"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <LinearLayout
                android:id="@+id/scrollContent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="10dp">

                <!-- ══ Welcome card ══ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_dashboard_hero"
                    android:elevation="4dp"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_welcome"
                        android:textColor="#CCFFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/home_headline"
                        android:textColor="@android:color/white"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                    <LinearLayout
                        style="@style/HomeHeroStat"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/homeCustomersCount"
                            style="@style/HomeHeroStatValue"
                            android:text="@string/zero" />

                        <TextView
                            style="@style/HomeHeroStatLabel"
                            android:text="@string/customers" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/HomeHeroStat"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp">

                        <TextView
                            android:id="@+id/homeEstimatesCount"
                            style="@style/HomeHeroStatValue"
                            android:text="@string/zero" />

                        <TextView
                            style="@style/HomeHeroStatLabel"
                            android:text="@string/estimates" />
                    </LinearLayout>

                    <LinearLayout
                        style="@style/HomeHeroStat"
                        android:layout_marginStart="6dp">

                        <TextView
                            android:id="@+id/homeSteelsCount"
                            style="@style/HomeHeroStatValue"
                            android:text="@string/zero" />

                        <TextView
                            style="@style/HomeHeroStatLabel"
                            android:text="@string/steels" />
                    </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/DashboardCardTitle"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp"
                    android:text="@string/home_quick_access" />

                <!-- ══ Shortcuts ══ -->
                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="@integer/home_columns"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileCustomers"
                        style="@style/HomeTile">

                        <LinearLayout style="@style/HomeTileContent">

                            <ImageView
                                android:id="@+id/imageViewCustomers"
                                style="@style/HomeTileIcon"
                                android:contentDescription="@string/customers"
                                android:src="@drawable/ic_toolbar_customers" />

                            <TextView
                                android:id="@+id/textViewCustomers"
                                style="@style/HomeTileLabel"
                                android:text="@string/customers" />

                            <TextView
                                style="@style/HomeTileCaption"
                                android:text="@string/home_caption_customers" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileEstimates"
                        style="@style/HomeTile">

                        <LinearLayout style="@style/HomeTileContent">

                            <ImageView
                                android:id="@+id/imageViewEstimates"
                                style="@style/HomeTileIcon"
                                android:contentDescription="@string/estimates"
                                android:src="@drawable/ic_toolbar_estimates" />

                            <TextView
                                android:id="@+id/textViewEstimates"
                                style="@style/HomeTileLabel"
                                android:text="@string/estimates" />

                            <TextView
                                style="@style/HomeTileCaption"
                                android:text="@string/home_caption_estimates" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileSteels"
                        style="@style/HomeTile">

                        <LinearLayout style="@style/HomeTileContent">

                            <ImageView
                                android:id="@+id/imageViewSteels"
                                style="@style/HomeTileIcon"
                                android:contentDescription="@string/steels"
                                android:src="@drawable/ic_toolbar_steels" />

                            <TextView
                                android:id="@+id/textViewSteels"
                                style="@style/HomeTileLabel"
                                android:text="@string/steels" />

                            <TextView
                                style="@style/HomeTileCaption"
                                android:text="@string/home_caption_steels" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileDashboard"
                        style="@style/HomeTile">

                        <LinearLayout style="@style/HomeTileContent">

                            <ImageView
                                android:id="@+id/imageViewDashboard"
                                style="@style/HomeTileIcon"
                                android:contentDescription="@string/dashboard"
                                android:src="@drawable/ic_toolbar_dashboard" />

                            <TextView
                                android:id="@+id/textViewDashboard"
                                style="@style/HomeTileLabel"
                                android:text="@string/dashboard" />

                            <TextView
                                style="@style/HomeTileCaption"
                                android:text="@string/home_caption_dashboard" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileBusiness"
                        style="@style/HomeTile">

                        <LinearLayout style="@style/HomeTileContent">

                            <ImageView
                                android:id="@+id/imageViewBusiness"
                                style="@style/HomeTileIcon"
                                android:contentDescription="@string/business"
                                android:src="@drawable/ic_toolbar_business" />

                            <TextView
                                android:id="@+id/textViewBusiness"
                                style="@style/HomeTileLabel"
                                android:text="@string/business" />

                            <TextView
                                style="@style/HomeTileCaption"
                                android:text="@string/home_caption_business" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileBackups"
                        style="@style/HomeTile">

                        <LinearLayout style="@style/HomeTileContent">

                            <ImageView
                                android:id="@+id/imageViewBackups"
                                style="@style/HomeTileIcon"
                                android:contentDescription="@string/backuprestore"
                                android:src="@drawable/ic_toolbar_backup" />

                            <TextView
                                android:id="@+id/textViewBackups"
                                style="@style/HomeTileLabel"
                                android:text="@string/backuprestore" />

                            <TextView
                                style="@style/HomeTileCaption"
                                android:text="@string/home_caption_backup" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileSettings"
                        style="@style/HomeTile">

                        <LinearLayout style="@style/HomeTileContent">

                            <ImageView
                                android:id="@+id/imageViewSettings"
                                style="@style/HomeTileIcon"
                                android:contentDescription="@string/settings"
                                android:src="@drawable/ic_toolbar_settings" />

                            <TextView
                                android:id="@+id/textViewSettings"
                                style="@style/HomeTileLabel"
                                android:text="@string/settings" />

                            <TextView
                                style="@style/HomeTileCaption"
                                android:text="@string/home_caption_settings" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/tileExit"
                        style="@style/HomeTile">

                        <LinearLayout style="@style/HomeTileContent">

                            <ImageView
                                android:id="@+id/imageViewExit"
                                style="@style/HomeTileIcon"
                                android:contentDescription="@string/exit"
                                android:background="@drawable/bg_home_exit_icon"
                                android:src="@drawable/ic_home_exit"
                                app:tint="@color/dashboard_negative" />

                            <TextView
                                android:id="@+id/textViewExit"
                                style="@style/HomeTileLabel"
                                android:text="@string/exit" />

                            <TextView
                                style="@style/HomeTileCaption"
                                android:text="@string/home_caption_exit" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>
                </GridLayout>
            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- Drawer menu -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navigationView"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:menu="@menu/drawer_menu"
        app:headerLayout="@layout/nav_header"
        app:itemIconTint="@color/drawer_icon_color"
        android:background="@android:color/white" />

</androidx.drawerlayout.widget.DrawerLayout>
