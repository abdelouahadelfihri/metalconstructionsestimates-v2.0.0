<?xml version="1.0" encoding="utf-8"?>
<!-- Steel details: profile and weight cards with a fixed Delete / Update bar -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dashboard_bg">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="0dp"
        android:layout_height="?attr/actionBarSize"
        android:background="#0066cc"
        android:theme="@style/ThemeOverlay.MaterialComponents.Dark.ActionBar"
        app:popupTheme="@style/ThemeOverlay.AppCompat.DayNight"
        app:title="@string/steelDetails"
        app:logo="@drawable/ic_toolbar_steels"
        app:contentInsetStartWithNavigation="0dp"
        app:titleMarginStart="10dp"
        app:titleTextAppearance="@style/ListToolbarTitle"
        app:titleTextColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/formScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbar">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="10dp">

            <!-- Full width on phones, capped and centered on tablets -->
            <LinearLayout
                android:id="@+id/formContent"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintWidth_max="@dimen/form_max_width">

                <LinearLayout
                    style="@style/FormHero">

                    <ImageView
                        style="@style/FormHeroIcon"
                        android:src="@drawable/ic_toolbar_steels" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/FormHeroTitle"
                            android:text="@string/form_steel_details_title" />

                        <TextView
                            style="@style/FormHeroSubtitle"
                            android:text="@string/form_steel_details_subtitle" />
                    </LinearLayout>
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    style="@style/FormCard">

                    <LinearLayout
                        style="@style/DashboardCardContent">

                        <LinearLayout
                            style="@style/FormSectionHeader">

                            <ImageView
                                style="@style/FormSectionIcon"
                                android:src="@drawable/ic_toolbar_steels" />

                            <LinearLayout
                                style="@style/FormSectionText">

                                <TextView
                                    style="@style/DashboardCardTitle"
                                    android:text="@string/form_section_profile" />

                                <TextView
                                    style="@style/DashboardCardSubtitle"
                                    android:text="@string/form_section_profile_subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <LinearLayout
                            style="@style/FormRow">
                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/steelIdInputLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_marginEnd="12dp"
                                android:hint="@string/steelId">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/steelIdEditText"
                                    style="@style/FormFieldInput"
                                    android:inputType="number"
                                    android:enabled="false" />
                            </com.google.android.material.textfield.TextInputLayout>

                            <com.google.android.material.textfield.TextInputLayout
                                android:id="@+id/steelTypeInputLayout"
                                style="@style/FormField"
                                android:layout_width="0dp"
                                android:layout_weight="2"
                                android:hint="@string/steelType">
                                <com.google.android.material.textfield.TextInputEditText
                                    android:id="@+id/steelTypeEditText"
                                    style="@style/FormFieldInput"
                                    android:inputType="text" />
                            </com.google.android.material.textfield.TextInputLayout>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/shapeSpinnerLabel"
                            style="@style/FormSpinnerLabel"
                            android:text="@string/shapeLabel" />

                        <Spinner
                            android:id="@+id/shapeSpinner"
                            style="@style/FormSpinner" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/FormCard">

                    <LinearLayout
                        style="@style/DashboardCardContent">

                        <LinearLayout
                            style="@style/FormSectionHeader">

                            <ImageView
                                style="@style/FormSectionIcon"
                                android:src="@drawable/ic_form_scale" />

                            <LinearLayout
                                style="@style/FormSectionText">

                                <TextView
                                    style="@style/DashboardCardTitle"
                                    android:text="@string/form_section_weight" />

                                <TextView
                                    style="@style/DashboardCardSubtitle"
                                    android:text="@string/form_section_weight_subtitle" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/weightInputLayout"
                            style="@style/FormField"
                            android:hint="@string/weight">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/weightEditText"
                                style="@style/FormFieldInput"
                                android:inputType="numberDecimal" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <TextView
                            android:id="@+id/unitSpinnerLabel"
                            style="@style/FormSpinnerLabel"
                            android:text="@string/unitLabel" />

                        <Spinner
                            android:id="@+id/unitSpinner"
                            style="@style/FormSpinner" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Actions stay visible at the bottom -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/buttonContainer"
        style="@style/FormActionBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="@dimen/form_max_width">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/deleteButton"
                style="@style/FormDangerButton"
                android:layout_marginEnd="6dp"
                android:text="@string/delete" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/updateButton"
                style="@style/FormPrimaryButton"
                android:layout_marginStart="6dp"
                android:text="@string/update" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
