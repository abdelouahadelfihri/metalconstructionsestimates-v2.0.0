<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                style="@style/DashboardPeriodStat"
                android:layout_marginEnd="6dp">

                <TextView
                    android:id="@+id/tv_estimate_count_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/periodCount"
                    android:textColor="@color/dashboard_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_estimate_count_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/dashboard_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="3" />
            </LinearLayout>

            <LinearLayout
                style="@style/DashboardPeriodStat"
                android:layout_marginStart="6dp">

                <TextView
                    android:id="@+id/tv_estimate_total_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/periodAmount"
                    android:textColor="@color/dashboard_text_secondary"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/tv_estimate_total_value"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="@color/dashboard_text_primary"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    tools:text="45,000.00 DH" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/tv_no_estimates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:paddingTop="28dp"
            android:paddingBottom="20dp"
            android:text="@string/noEstimates"
            android:textColor="@color/dashboard_text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_estimates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:nestedScrollingEnabled="false" />
    </LinearLayout>
</layout>
